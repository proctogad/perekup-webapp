# Скопируйте этот файл в `.env` и заполните значения.
# `.env` не попадает в git — токен и вебхук остаются локально.

# Токен бота: Discord Developer Portal → приложение → Bot → Reset Token
DISCORD_BOT_TOKEN=

# ID сервера (ПКМ по серверу → «Копировать ID» при включённом режиме разработчика)
DISCORD_GUILD_ID=

# Появится после `python post_update.py --create-webhook --apply`
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
