# Скопируйте этот файл в `.env` и заполните значения.
# `.env` не попадает в git — токен остаётся локально.

# Токен бота: Discord Developer Portal → приложение → Bot → Reset Token
DISCORD_BOT_TOKEN=

# ID сервера (можно оставить пустым — возьмётся из config.json)
# DISCORD_GUILD_ID=1559945024114794586

# Приветствие, роль «Новичок» и источник входа требуют SERVER MEMBERS INTENT.
# Включите его в портале; сюда true/false.
MEMBERS_INTENT=true

# Необязательно: путь к invites.json (по умолчанию — рядом с bot.py)
# INVITES_FILE=invites.json

# Необязательно: JSON инвайтов одной строкой — для хостингов без файлов
# INVITES_JSON={"invites":[...]}

# Необязательно: путь к state.json (по умолчанию — рядом с bot.py)
# STATE_FILE=state.json
